#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <21 22>;
            timeout-ms = <100>;
        };

        coppy {
            bindings = <&kp LG(C)>;
            key-positions = <23 22>;
            timeout-ms = <100>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <23 24>;
            timeout-ms = <100>;
        };

        left_half {
            bindings = <&kp LA(LC(LEFT))>;
            key-positions = <16 17 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        righthalf {
            bindings = <&kp LA(LC(RIGHT))>;
            key-positions = <17 18 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        leftquarter {
            bindings = <&kp LA(LC(Z))>;
            key-positions = <16 17 18 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rightq {
            bindings = <&kp LA(LC(X))>;
            key-positions = <18 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        Full {
            bindings = <&kp LA(LC(RET))>;
            key-positions = <17 18 19 16>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        increase {
            bindings = <&kp LA(LC(PLUS))>;
            key-positions = <6 7 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        decrease {
            bindings = <&kp LA(LC(MINUS))>;
            key-positions = <31 16 17>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        magnify {
            bindings = <&kp LG(PLUS)>;
            key-positions = <20 3>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        micro {
            bindings = <&kp LG(MINUS)>;
            key-positions = <20 2>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
            slow-release;
        };

        mdnolinepaste {
            bindings = <&kp LG(LS(M))>;
            key-positions = <23 24 22>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        raycast {
            bindings = <&kp LG(SPACE)>;
            key-positions = <13 11 12>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        finder {
            bindings = <&kp LA(LG(SPACE))>;
            key-positions = <12 13 23 24>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        print {
            bindings = <&kp LG(P)>;
            key-positions = <9 31>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        lq {
            bindings = <&kp LA(LC(Z))>;
            key-positions = <11 20 12 13>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rug {
            bindings = <&kp LA(LC(X))>;
            key-positions = <20 13>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        lefthalf {
            bindings = <&kp LA(LC(LEFT))>;
            key-positions = <20 12 11>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rhalf {
            bindings = <&kp LA(LC(RIGHT))>;
            key-positions = <20 12 13>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        reload {
            bindings = <&kp LG(R)>;
            key-positions = <2 3 1>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        undo {
            bindings = <&kp LG(Z)>;
            key-positions = <21 22 23>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        redo {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <10 11 12>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        fullsize {
            bindings = <&kp LC(LG(F))>;
            key-positions = <17 16 31 27 28>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        fullsize0 {
            bindings = <&kp LC(LG(F))>;
            key-positions = <20 23 24 12 13>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        retur {
            bindings = <&kp ENTER>;
            key-positions = <21 22 23 24>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rretr {
            bindings = <&kp ENTER>;
            key-positions = <27 28 29 30>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1 2 3>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rtab {
            bindings = <&kp TAB>;
            key-positions = <6 7 8 9>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        rfull {
            bindings = <&kp LA(LC(RET))>;
            key-positions = <11 12 13 10>;
            timeout-ms = <100>;
            require-prior-idle-ms = <50>;
        };

        back {
            bindings = <&kp LG(LEFT_BRACKET)>;
            key-positions = <0 1>;
        };

        forwarddd {
            bindings = <&kp LG(RIGHT_BRACKET)>;
            key-positions = <2 3>;
        };

        delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };
    };

    macros {
        /* ds: 클릭 → (포커스 대기) → 탭전환(Cmd+Tab) → 붙여넣기(Cmd+V) → Tab → Enter */

        ds: ds {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <30>;
            bindings =
                <&mkp MB1>,
                <&macro_wait_time 500>,
                <&kp LG(TAB)>,
                <&macro_wait_time 10>,
                <&kp LG(V) &kp TAB &kp ENTER>;
        };

        ts: ts {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <30>;
            bindings =
                <&kp LG(TAB)>,
                <&macro_wait_time 10>,
                <&kp LG(V) &kp TAB &kp ENTER>;

            label = "TS";
        };

        semiauto: semiauto {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <30>;
            bindings =
                <&kp LG(TAB)>,
                <&macro_wait_time 10>,
                <&kp LG(V) &kp TAB>;

            label = "SEMIAUTO";
        };

        sssc: sssc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <30>;
            bindings =
                <&kp LS(TAB)>,
                <&macro_wait_time 10>,
                <&kp LG(V) &kp TAB>;

            label = "SSSC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Base Layer: 10-10-12 구조 (Totem 스타일) */

        base {
            bindings = <
                 &kp Q        &kp W       &kp E       &kp R        &kp T        &kp Y      &kp U            &kp I         &kp O       &kp P
                 &hm LCTRL A  &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G        &kp H      &hm RSHFT J      &hm RGUI K    &hm RALT L  &hm RCTRL SEMI
&lt 8 LC(SPACE)  &kp Z        &kp X       &kp C       &kp V        &kp B        &kp N      &kp M            &kp COMMA     &kp DOT     &kp FSLH        &hm SQT LS(SQT)
                                          &lt 1 ESC   &lt 2 SPACE  &lt 3 TAB    &lt 4 RET  &lt 5 BACKSPACE  &lt 6 DELETE
            >;
        };

        Media {
            bindings = <
            &kp F14            &kp F15           &kp LA(LS(F14))       &kp LA(LS(F15))          &ds                 &trans  &ext_power EP_TOG  &caps_word  &trans  &trans
            &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp LS(LA(C_VOL_DN))  &kp LA(LS(C_VOLUME_UP))  &ts                 &trans  &trans             &trans      &trans  &trans
&kp C_MUTE  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT            &kp LC(N5)               &kp LC(NUMBER_6)    &trans  &trans             &trans      &trans  &trans  &trans
                                                 &trans                &trans                   &trans              &trans  &trans             &trans
            >;
        };

        nav_num {
            bindings = <
                &hm LG(BSPC) LA(BACKSPACE)  &kp BSPC      &kp UP       &kp DEL        &kp LA(DEL)      &kp SPACE  &hm LS(N7) N7             &hm LS(N8) N8         &hm LS(N9) N9                  &kp STAR
                &kp LA(LEFT)                &kp LEFT      &kp DOWN     &kp RIGHT      &kp LA(RIGHT)    &kp MINUS  &hm DOLLAR NUMBER_4       &hm PERCENT N5        &hm LEFT_PARENTHESIS NUMBER_6  &kp FSLH
&kp LEFT_SHIFT  &kp LG(UP)                  &kp LG(LEFT)  &hm TAB RET  &kp LG(RIGHT)  &kp LG(DOWN)     &kp DOT    &hm EXCLAMATION NUMBER_1  &hm AT_SIGN NUMBER_2  &hm HASH NUMBER_3              &hm LS(N0) N0  &lt 8 PERIOD
                                                          &trans       &trans         &trans           &trans     &trans                    &trans
            >;
        };

        Num_Mouse {
            bindings = <
            &kp STAR       &hm LS(N7) N7              &hm LS(N8) N8        &hm LS(N9) N9              &hm GRAVE LS(GRAVE)     &msc SCRL_LEFT  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &msc SCRL_RIGHT
            &kp FSLH       &hm LS(NUMBER_4) NUMBER_4  &hm LS(N5) N5        &hm LS(NUMBER_6) NUMBER_6  &hm UNDERSCORE MINUS    &mmv MOVE_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&kp PERIOD  &hm LS(N0) N0  &hm LS(NUMBER_1) NUMBER_1  &hm LS(N2) NUMBER_2  &hm LS(NUMBER_3) NUMBER_3  &hm PLUS EQUAL          &mkp MB4        &mkp MB5        &kp RGUI        &kp RALT         &kp RCTRL        &trans
                                                      &kp RCTRL            &kp LEFT_GUI               &trans                  &kp RET         &mkp LCLK       &mkp RCLK
            >;
        };

        td_num {
            bindings = <
        &hm RBKT LEFT_BRACKET       &kp AMPERSAND    &kp ASTERISK  &hm RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp LG(E)    &kp BACKSPACE         &hm AMPERSAND N7          &hm ASTERISK N8       &hm LEFT_PARENTHESIS N9  &kp ASTERISK
        &hm RIGHT_BRACE LEFT_BRACE  &kp DOLLAR       &kp PERCENT   &kp CARET                               &trans       &hm UNDERSCORE MINUS  &hm DOLLAR NUMBER_4       &hm PERCENT N5        &hm LCTRL NUMBER_6       &kp FSLH
&trans  &trans                      &kp EXCLAMATION  &kp AT_SIGN   &kp HASH                                &kp GRAVE    &kp MINUS             &hm EXCLAMATION NUMBER_1  &hm AT_SIGN NUMBER_2  &hm HASH NUMBER_3        &hm RIGHT_PARENTHESIS N0  &trans
                                                     &trans        &trans                                  &trans       &trans                &trans                    &kp STAR
            >;
        };

        markdown_layer {
            bindings = <
        &hm RBKT RIGHT_BRACKET      &kp AMPERSAND    &kp ASTERISK  &hm RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp LG(E)    &hm LG(LA(N5)) LG(LC(N5))  &hm LG(LA(N4)) LG(LC(N4))  &kp LG(LA(I))  &hm LG(LA(N2)) LG(LC(N2))  &hm LG(LA(N1)) LG(LC(N1))
        &hm LEFT_BRACE RIGHT_BRACE  &kp DOLLAR       &kp PERCENT   &kp CARET                               &trans       &hm LG(LA(N6)) LG(LC(N6))  &kp LG(LA(J))              &kp LG(LA(K))  &kp LG(LA(L))              &hm LG(LA(N3)) LG(LC(N3))
&trans  &trans                      &kp EXCLAMATION  &kp AT_SIGN   &kp HASH                                &kp GRAVE    &trans                     &trans                     &trans         &trans                     &trans                     &trans
                                                     &trans        &trans                                  &trans       &trans                     &trans                     &trans
            >;
        };

        Macrol {
            bindings = <
                 &kp LS(Q)            &kp LG(W)           &kp LS(E)           &kp LS(R)  &kp LS(T)    &kp LS(Y)  &kp LS(U)               &kp LS(I)            &kp LS(O)                  &kp LS(P)
                 &hm LS(LCTRL) LS(A)  &hm LS(LALT) LS(S)  &hm LS(LGUI) LS(D)  &kp LG(F)  &kp LS(G)    &kp RS(H)  &hm RS(J) RG(NUMBER_4)  &hm RS(RGUI) RG(N5)  &hm RS(RALT) RG(NUMBER_6)  &hm RS(RCTRL) RA(SEMI)
&kp LS(LC(F19))  &kp LS(LG(Z))        &kp LG(X)           &kp RG(C)           &kp LG(V)  &kp LS(B)    &kp LS(N)  &kp RG(NUMBER_1)        &kp RG(NUMBER_2)     &kp RG(NUMBER_3)           &kp LS(FSLH)            &kp LC(F19)
                                                          &kp ESC             &kp SPACE  &kp TAB      &kp RET    &kp BSPC                &trans
            >;
        };

        device {
            bindings = <
        &trans      &kp F14       &kp F15       &trans    &trans    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP  &trans    &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans        &trans        &trans    &trans    &trans        &trans        &gresc        &trans        &trans        &bt BT_CLR
                                  &trans        &trans    &trans    &trans        &trans        &trans
            >;
        };

        button_8 {
            bindings = <
        &kp Q               &kp W                     &kp TAB             &kp RET                   &ts              &kp RG(RS(Z))  &kp RG(V)         &kp RG(C)         &kp RG(X)         &kp RG(Z)
        &kp LG(A)           &kp LG(LA(LS(NUMBER_4)))  &kp LG(LA(LS(N5)))  &kp LG(LA(LS(N0)))        &ds              &none          &mkp LCLK         &mkp MCLK         &kp RG(L)         &kp LG(L)
&trans  &kp LS(LA(LG(N0)))  &kp RG(RA(RS(NUMBER_1)))  &kp LG(LA(LS(C)))   &kp LG(LA(LS(NUMBER_3)))  &kp LG(LS(Z))    &none          &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(N5)  &kp RIGHT_SHIFT
                                                      &trans              &trans                    &trans           &trans         &trans            &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <7>;
        };

        hotsowop {
            if-layers = <2 5>;
            then-layer = <0>;
        };
    };
};
